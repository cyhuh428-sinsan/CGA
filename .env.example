API_PORT=8320
CGA_INTERNAL_API_BASE_URL=http://127.0.0.1:8320
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EDIT_LOCK_CLEANUP_ENABLED=true
EDIT_LOCK_CLEANUP_INTERVAL_SECONDS=60

# API를 로컬에서 직접 실행할 때 운영 환경에 맞게 지정합니다.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# CGA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cga
# CGA_JWT_SECRET=replace-with-a-long-random-secret
# CGA_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
# CGA_LICENSE_PUBLIC_KEY=base64-encoded-cga-license-public-key
# REDIS_URL=redis://127.0.0.1:6379/0
# AIDOT_VECTOR_WORKER_BASE_URL=http://127.0.0.1:8350
# CGA_VECTOR_EMBEDDING_PROVIDER=ollama
# CGA_VECTOR_EMBEDDING_MODEL=bge-m3:latest
# CGA_OLLAMA_BASE_URL=http://host.docker.internal:11434
# CGA_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# JWT_SECRET=replace-with-a-secure-secret
