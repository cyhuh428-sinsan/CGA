{
  "dependencies": {
    "docx": "^9.7.1"
  },
  "scripts": {
    "studio": "node scripts/serve-studio.js",
    "studio:check": "node --check scripts/serve-studio.js",
    "studio:state-check": "node --check packages/public-core/src/studio-state.js",
    "studio:access-check": "node --check packages/public-core/src/access-state.js",
    "studio:auth-check": "node --check packages/contracts/src/auth-api-contract.js",
    "studio:asset-transfer-check": "node --check packages/contracts/src/asset-transfer-api-contract.js",
    "studio:style-check": "node scripts/check-studio-style.js",
    "studio:config-check": "node scripts/check-studio-config.js",
    "studio:validate": "npm run studio:check && npm run studio:state-check && npm run studio:access-check && npm run studio:auth-check && npm run studio:asset-transfer-check && npm run studio:module-check && npm run studio:style-check && npm run studio:config-check && npm run studio:i18n-check",
    "studio:module-check": "node --check packages/public-core/src/module-registry.js",
    "studio:i18n-check": "node scripts/check-i18n-coverage.js",
    "studio:container": "docker-compose up --build cga-studio",
    "studio:container:down": "docker-compose down"
  }
}
